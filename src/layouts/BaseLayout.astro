---
import MetaTags from "../components/MetaTags.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "virtual:sugarcube.css";
import "../styles/main.css";

interface Props {
  description?: string;
  fullTitle?: string;
  nofollow?: boolean;
  noindex?: boolean;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogPublishedTime?: string;
  ogTags?: string[];
  ogTitle?: string;
  ogType?: string;
  title?: string;
  mode?: string;
}

const {
  description,
  fullTitle,
  nofollow = false,
  noindex = false,
  ogDescription,
  ogImage,
  ogImageAlt,
  ogPublishedTime,
  ogTags = [],
  ogTitle,
  ogType,
  title,
  mode,
} = Astro.props;
---

<html lang="en" data-mode={mode}>
  <head>
    <MetaTags
      description={description}
      fullTitle={fullTitle}
      nofollow={nofollow}
      noindex={noindex}
      ogDescription={ogDescription}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogPublishedTime={ogPublishedTime}
      ogTags={ogTags}
      ogTitle={ogTitle}
      ogType={ogType}
      title={title}
    />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="content" class="wrapper">
      <article>
        <slot />
      </article>
    </main>
    <Footer />
  </body>
  <style>
    .skip-link {
      position: absolute;
      top: -3em;
      background: var(--color-surface-raised);
      padding-block: var(--space-sm);
      z-index: 1;
      padding-inline: var(--space-lg);
    }
    .skip-link:focus {
      top: 0;
    }
  </style>
</html>
