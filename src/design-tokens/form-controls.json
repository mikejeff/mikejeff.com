{
  "form-control": {
    "border-width": {
      "$value": "{border.width.thin}"
    },
    "border-style": {
      "$value": "{border.style}"
    },
    "radius": {
      "$value": "{radius.lg}"
    },
    "line-height": {
      "$value": "{leading.normal}"
    },
    "font-size": {
      "$value": "{text.sm}"
    },
    "toggle-size": {
      "$type": "dimension",
      "$value": { "value": 1.25, "unit": "rem" }
    },
    "label": {
      "line-height": { "$value": "{leading.tight}" }
    }
  }
}
